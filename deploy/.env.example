# Produccion con dominio:
# SITE_ADDRESS=https://norder.example.com
# PUBLIC_APP_URL=https://norder.example.com
#
# Prueba temporal por IP, sin credenciales ni datos reales:
SITE_ADDRESS=http://177.7.49.184
PUBLIC_APP_URL=http://177.7.49.184

# PostgreSQL privado. Usa una contrasena larga con letras y numeros para evitar
# problemas al construir DATABASE_URL dentro de Compose.
POSTGRES_DB=norder
POSTGRES_USER=norder
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_ALEATORIA

# Autenticacion principal
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO
JWT_EXPIRES_IN=30d
PORTAL_JWT_EXPIRES_IN=30d
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_ALEATORIA

# Proteccion obligatoria de /api/agent en produccion
AGENT_API_KEY=CAMBIAR_POR_UN_SECRETO_ALEATORIO

# IA y automatizaciones
GEMINI_API_KEY=
GEMINI_MODEL=
N8N_CHAT_WEBHOOK_URL=
