<!DOCTYPE html>
<html lang="es-mx">
<head>
    <meta charset="UTF-8">
    <title>Plan Nutricional - <%= paciente.nombre %></title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
        
        @page {
            size: A4 landscape;
            margin: 0;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
        
        body {
            background-color: #fff;
            color: #000;
            font-size: 9px;
        }

        .page {
            width: 297mm;
            height: 210mm;
            overflow: hidden;
            padding: 15mm 18mm;
            position: relative;
            page-break-after: always;
            background: #fff;
        }
        .extras-page {
            height: 210mm;
            min-height: 210mm;
            overflow: hidden;
            padding: 10mm 16mm;
            page-break-inside: avoid;
        }
        .extras-page .header { margin-bottom: 10px; }
        .extras-page .header-logo img { width: 112px; }
        .extras-page .header-info { font-size: 7px; line-height: 1.25; }
        .extras-page .header-info strong { font-size: 8px; }
        .extras-page .section-title {
            font-size: 9px;
            margin-top: 7px !important;
            margin-bottom: 4px !important;
        }
        .extras-page table { margin-bottom: 7px; }
        .extras-page .extras-distribution-grid {
            gap: 10px !important;
            margin-bottom: 8px !important;
        }
        .extras-page .extras-distribution-card {
            width: calc(50% - 5px) !important;
            margin-bottom: 0 !important;
        }
        .extras-page .extras-distribution-title {
            font-size: 10px !important;
            padding: 3px 0 !important;
        }
        .extras-page .extras-distribution-table { margin-bottom: 0 !important; }
        .extras-page .extras-distribution-table th,
        .extras-page .extras-distribution-table td {
            padding: 1.5px 6px !important;
            font-size: 7.5px !important;
            line-height: 1.05 !important;
        }
        .extras-page .supl-table { margin-bottom: 7px; }
        .extras-page .supl-table th,
        .extras-page .supl-table td {
            padding: 2px 6px;
            font-size: 8px;
            line-height: 1.1;
        }
        .extras-page tr { break-inside: avoid; page-break-inside: avoid; }
        .extras-page .section-title { break-after: avoid; page-break-after: avoid; }

        /* HEADER */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }
        .header-logo {
            font-size: 32px;
            font-weight: 800;
            color: #7b8898;
            letter-spacing: -1px;
            line-height: 1;
        }
        .header-logo img {
            width: 140px;
            height: auto;
            object-fit: contain;
            display: block;
        }
        .header-logo span {
            display: block;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 4px;
            color: #a0a0a0;
            margin-top: 4px;
        }
        .header-info {
            text-align: right;
            font-size: 9px;
            color: #333;
            line-height: 1.4;
        }
        .header-info strong {
            font-size: 10px;
            color: #000;
        }

        /* TITLE */
        .title-name {
            font-size: 16px;
            font-weight: 800;
            margin-bottom: 15px;
            color: #000;
        }
        .avoid-foods-summary {
            width: 100%;
            border: 1px solid #000;
            margin-top: 6px;
            padding: 5px 8px;
            line-height: 1.25;
            white-space: normal;
            overflow-wrap: anywhere;
            word-break: break-word;
            page-break-inside: avoid;
        }
        .avoid-foods-summary__title {
            display: block;
            font-weight: 700;
            margin-bottom: 2px;
        }
        .avoid-foods-summary__empty {
            color: #777;
            font-style: italic;
        }

        /* TABLES */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
        }
        th, td {
            border: 1px solid #000;
            padding: 5px 8px;
            font-size: 10px;
            text-align: left;
            vertical-align: top;
        }
        th {
            font-weight: 700;
            background-color: #fff;
        }
        .text-center { text-align: center; }
        .font-bold { font-weight: 700; }
        .bg-gray { background-color: #f5f5f5; }

        /* HIGHLIGHTS */
        .highlight-yellow {
            background-color: #ffff00;
            font-weight: bold;
            display: inline-block;
            padding: 2px 4px;
        }

        /* LISTS */
        .bullet-list { margin-left: 15px; margin-bottom: 15px; }
        .bullet-list li { margin-bottom: 4px; }

        /* CUSTOM SECTIONS */
        .section-title {
            font-size: 12px;
            font-weight: 800;
            margin-bottom: 8px;
            margin-top: 15px;
        }

        .side-images {
            width: 125px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            align-items: flex-end;
            padding-left: 0;
            overflow: visible;
        }
        .side-images > .body-types-image {
            width: 240px;
            max-width: none;
            height: auto;
            object-fit: contain;
            object-position: right top;
            margin-top: -12px;
            transform: translateX(60px);
        }
        .online-followup-page {
            display: flex;
            flex-direction: column;
        }
        .online-followup-heading {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 9px;
        }
        .online-followup-heading .title-name { margin-bottom: 0; }
        .online-followup-badge {
            border: 1px solid #222;
            border-radius: 999px;
            padding: 4px 10px;
            font-size: 8px;
            font-weight: 700;
            letter-spacing: .04em;
            text-transform: uppercase;
            white-space: nowrap;
        }
        .online-photo-gallery {
            flex: 1;
            min-height: 0;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            grid-template-rows: repeat(2, minmax(0, 1fr));
            gap: 8px;
            margin-bottom: 7px;
        }
        .online-photo-gallery[data-count="1"] {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .online-photo-gallery[data-count="2"] {
            grid-template-rows: minmax(0, 1fr);
        }
        .online-photo-card {
            position: relative;
            min-width: 0;
            min-height: 0;
            overflow: hidden;
            border: 1px solid #222;
            background: #f5f5f5;
            padding: 5px;
            break-inside: avoid;
        }
        .online-photo-gallery[data-count="1"] .online-photo-card {
            width: 105mm;
            height: 121mm;
        }
        .online-photo-card img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
            object-position: center;
        }
        .online-photo-principal {
            position: absolute;
            top: 7px;
            left: 7px;
            z-index: 1;
            padding: 3px 6px;
            border-radius: 999px;
            background: rgba(0, 0, 0, .78);
            color: #fff;
            font-size: 7px;
            font-weight: 700;
        }
        .online-photo-empty {
            flex: 1;
            min-height: 95mm;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px dashed #aaa;
            color: #777;
            font-size: 10px;
        }
        .online-followup-page .avoid-foods-summary {
            flex-shrink: 0;
            margin-top: 0;
        }

        /* ── MENU GRID — Layout auto-escalable ────────────────────────────── */
        /* .menu-page convierte la página en columna flex para que el grid
           se expanda y llene exactamente el espacio disponible */
        .menu-page {
            display: flex;
            flex-direction: column;
        }
        /* Wrapper que ocupa todo el espacio bajo el header */
        .menu-page-body {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }
        /* El grid en sí es también una columna flex */
        .menu-grid {
            border: 1px solid #000;
            width: 100%;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }
        /* Cada fila de contenido se reparte el espacio equitativamente */
        .menu-row {
            display: flex;
            border-bottom: 1px solid #000;
            flex: 1;
            min-height: 0;
            overflow: hidden;
        }
        /* Filas fijas (cabecera y footer) NO se expanden */
        .menu-row.fixed-row {
            flex: 0 0 auto;
        }
        .menu-row:last-child { border-bottom: none; }
        .menu-col {
            flex: 1;
            border-right: 1px solid #000;
            padding: 5px 6px;
            overflow: hidden;
            min-height: 0;
        }
        .menu-col:last-child { border-right: none; }
        /* Tamaños base — serán sobreescritos por el bloque dinámico en página 2 */
        .menu-time { font-weight: bold; margin-bottom: 3px; font-size: 10px; }
        .menu-time-subtitle { font-weight: normal; text-transform: none; font-size: 8px; display: block; margin-top: 1px; }
        .menu-item { margin-bottom: 2px; padding-left: 10px; font-size: 8.5px; line-height: 1.3; }
        .menu-sub  { display: block; padding-left: 14px; font-size: 7.5px; color: #555; line-height: 1.25; }
        .menu-water { margin-top: 5px; font-size: 9px; }
        .menu-bebida { margin-top: 3px; font-size: 9px; color: #000; }
        .menu-supl { margin-top: 2px; font-size: 9px; color: #000; }
        .supl-table { width: 100%; border-collapse: collapse; font-size: 10px; margin-bottom: 15px; }
        .supl-table th, .supl-table td { border: 1px solid #000; padding: 4px 8px; text-align: left; }
        .supl-table th { background: #f0f0f0; font-weight: 700; }
        .supl-activo { color: #22863a; font-weight: bold; }
        .supl-suspendido { color: #999; font-weight: bold; }
        .supl-row-suspended { opacity: 0.55; text-decoration: line-through; }
        .spelling-preview-error {
            color: #b91c1c !important;
            background: rgba(254, 202, 202, 0.55);
            text-decoration-line: underline;
            text-decoration-style: wavy;
            text-decoration-color: #dc2626;
            text-decoration-thickness: 1px;
            text-underline-offset: 2px;
        }
    </style>
</head>
<body>

<% 
    // SETUP VARIABLES
    const meta = plan.pdfCustomMeta || {};
    const showHistorial = meta.showPageHistorial !== false;
    const showMenus = meta.showPageMenus !== false;
    const showIntercambio = meta.showPageIntercambio !== false;
    const showExtras = meta.showPageExtras !== false;
    const formatMealTimeName = (value) => {
        const original = String(value || '').trim();
        if (!original) return '';
        const normalized = original.toLocaleLowerCase('es-MX').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        const suffixMatch = normalized.match(/^(.*?)(\s+\d+)$/);
        const base = suffixMatch ? suffixMatch[1] : normalized;
        const suffix = suffixMatch ? suffixMatch[2] : '';
        const names = {
            desayuno: 'Desayuno', colacion: 'Colación', almuerzo: 'Almuerzo', comida: 'Comida', cena: 'Cena',
            'pre entreno': 'Pre-entreno', 'pre-entreno': 'Pre-entreno',
            'post entreno': 'Post-entreno', 'post-entreno': 'Post-entreno'
        };
        return names[base] ? names[base] + suffix : original;
    };
    
    // Setup menus map to split into Menu 1 and Menu 2 if they exist
    const menu1 = plan.menus && plan.menus[0] ? plan.menus[0] : null;
    const menu2 = plan.menus && plan.menus[1] ? plan.menus[1] : null;

    // Get all distinct time SLOTS from menus to draw rows based on base meal name.
    // Un mismo nombre base (p.ej. "Colación") puede repetirse varias veces al día
    // (antes de almuerzo, después de almuerzo, después de cena...), así que cada
    // aparición se trata como una fila independiente identificada por su ocurrencia
    // (1ª "Colación", 2ª "Colación", etc.) en vez de colapsarse por nombre.
    let timeNames = []; // [{ name, occ }]
    const pushTimeSlots = (menu) => {
        if (!menu) return;
        const localCount = {};
        menu.tiemposComida.forEach(t => {
            const baseName = t.nombre.split('.')[0].trim();
            localCount[baseName] = (localCount[baseName] || 0) + 1;
            const occ = localCount[baseName];
            if (!timeNames.some(tn => tn.name === baseName && tn.occ === occ)) {
                timeNames.push({ name: baseName, occ });
            }
        });
    };
    pushTimeSlots(menu1);
    pushTimeSlots(menu2);

    // Busca la n-ésima aparición de un nombre base dentro de un array de tiemposComida
    const findTiempoByOccurrence = (tiempos, baseName, occ) => {
        let count = 0;
        for (const t of tiempos) {
            if (t.nombre.split('.')[0].trim() === baseName) {
                count++;
                if (count === occ) return t;
            }
        }
        return null;
    };
    
    // Sort valoraciones chronologically (oldest to newest) for the history table
    // We use the 'valoraciones' variable passed explicitly by the backend payload
    const hist = Array.isArray(valoraciones) ? valoraciones.slice().reverse() : []; 
    // Fill up to 7 columns
    const cols = Array(7).fill(null);
    hist.forEach((v, i) => { if (i < 7) cols[i] = v; });

    const measurementText = (valuation, field, value) => {
        if (!valuation) return '';
        const status = valuation.medicionesEstado && valuation.medicionesEstado[field];
        if (status === 'NO_APLICA') return 'No aplica';
        if (value == null || value === '') return '-';
        return value;
    };

    const headerHTML = `
        <div class="header">
            <div class="header-logo">
                ${logoMenuImg ? '<img src="' + logoMenuImg + '" alt="Norder">' : 'NORDER<span>THINK · EAT · LIVE</span>'}
            </div>
            <div class="header-info proper-name">
                <strong>L.N. Eyder Méndez Gamboa</strong><br>
                Certificación ISAK Nivel 2<br>
                Cédula: 11181890<br>
                999 453 7182 / nordermx@gmail.com<br>
                <strong>VIA "Vida Integral y Asesoría Profesional"</strong><br>
                Calle 40 #278 G, Campestre C.P. 97120. Mérida, Yucatán.
            </div>
        </div>
    `;
%>

<!-- PAGE 1: HISTORIAL -->
<% if (showHistorial) { %>
<div class="page <%= plan.consultaEnLinea ? 'online-followup-page' : '' %>">
    <%- headerHTML %>
    <% if (plan.consultaEnLinea) { %>
        <%
            const fotosOnline = Array.isArray(plan.fotosSeguimientoReporte)
                ? plan.fotosSeguimientoReporte.slice(0, 4)
                : [];
        %>
        <div class="online-followup-heading">
            <div class="title-name proper-name">Nombre: <%= paciente.nombre %> <%= paciente.apellido || '' %></div>
            <div class="online-followup-badge">Consulta en línea · Seguimiento fotoscópico</div>
        </div>

        <% if (fotosOnline.length > 0) { %>
            <div class="online-photo-gallery" data-count="<%= fotosOnline.length %>">
                <% fotosOnline.forEach((foto, index) => { %>
                    <div class="online-photo-card">
                        <% if (foto.esPrincipal || index === 0) { %>
                            <span class="online-photo-principal">Principal</span>
                        <% } %>
                        <img src="<%= foto.dataUrl %>" alt="Fotografía de seguimiento <%= index + 1 %>">
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="online-photo-empty">Sin fotografías de seguimiento registradas.</div>
        <% } %>

        <% if (meta.showAlimentosEvitar !== false) { %>
            <%
                const evitarOnline = Array.isArray(plan.evitarReciente) ? plan.evitarReciente : [];
                const evitarOnlineTexto = evitarOnline.join(' · ');
                const evitarOnlineFontSize = evitarOnlineTexto.length > 700 ? 6.5 : evitarOnlineTexto.length > 350 ? 7.25 : 8.5;
            %>
            <div class="avoid-foods-summary" style="font-size: <%= evitarOnlineFontSize %>px;">
                <span class="avoid-foods-summary__title">Alimentos a evitar / No consume / No le gustan:</span>
                <% if (evitarOnline.length > 0) { %>
                    <span><%= evitarOnlineTexto %></span>
                <% } else { %>
                    <span class="avoid-foods-summary__empty">Sin información registrada.</span>
                <% } %>
            </div>
        <% } %>
    <% } else { %>
    <!-- Layout flex: contenido a la izquierda + imagen tipos de cuerpo a la derecha -->
    <div style="display: flex; gap: 8px; align-items: flex-start;">
        <!-- Columna izquierda: contenido -->
        <div style="flex: 1; min-width: 0;">
            <div class="title-name proper-name">Nombre: <%= paciente.nombre %> <%= paciente.apellido || '' %></div>
            
            <table>
                <tr>
                    <td class="font-bold">Fecha</td>
                    <% cols.forEach(c => { 
                        let fStr = '';
                        if (c) {
                            try {
                                const raw = c.fecha instanceof Date ? c.fecha.toISOString() : String(c.fecha);
                                const d = new Date(raw.split('T')[0] + 'T12:00:00');
                                fStr = d.toLocaleDateString("es-MX", { day: "2-digit", month: "2-digit", year: "2-digit" });
                            } catch (e) { fStr = String(c.fecha); }
                        }
                    %>
                        <td><%= fStr %></td>
                    <% }); %>
                </tr>
                <tr>
                    <td class="font-bold">Objetivo</td>
                    <% cols.forEach(c => { %>
                        <td><%= c && c.objetivo ? c.objetivo : '' %></td>
                    <% }); %>
                </tr>
                <tr><td colspan="8" class="font-bold text-center">Resultados Generales</td></tr>
                <tr>
                    <td class="font-bold">Peso</td>
                    <% cols.forEach(c => { %><td><%= measurementText(c, 'peso', c?.pesoActual) %></td><% }); %>
                </tr>
                <tr>
                    <td class="font-bold">Talla (cm)</td>
                    <% cols.forEach(c => { %><td><%= measurementText(c, 'estatura', c?.estatura) %></td><% }); %>
                </tr>
                <tr><td colspan="8" class="font-bold text-center">Resultados Antropométricos</td></tr>
                <tr>
                    <td class="font-bold">% Grasa</td>
                    <% cols.forEach(c => { %><td><%= measurementText(c, 'pctGrasa', c?.pctGrasaCorp) %></td><% }); %>
                </tr>
                <tr>
                    <td class="font-bold">Kg Grasa</td>
                    <% cols.forEach(c => { %><td><%= measurementText(c, 'kgGrasa', c?.masaGrasaReal) %></td><% }); %>
                </tr>
                <tr>
                    <td class="font-bold">Kg MLG</td>
                    <% cols.forEach(c => { %><td><%= measurementText(c, 'masaMagra', c?.masaMagra) %></td><% }); %>
                </tr>
                <tr>
                    <td class="font-bold">Somatotipo</td>
                    <% cols.forEach(c => { %><td><%= (c && c.somatotipo) ? c.somatotipo : '' %></td><% }); %>
                </tr>
                <tr>
                    <td class="font-bold">Energía(kcal)</td>
                    <% cols.forEach(c => { %><td><%= (c && c.energia != null) ? c.energia : '' %></td><% }); %>
                </tr>
            </table>

            <% 
               const lArray = (plan.lineamientosRecientes && plan.lineamientosRecientes.length > 0)
                   ? plan.lineamientosRecientes
                   : ((meta.lineamientos && meta.lineamientos.length > 0) ? meta.lineamientos : []);
               
               if (lArray.length > 0) {
            %>
                <div class="font-bold" style="margin-bottom: 4px;">Lineamientos:</div>
                <ul class="bullet-list" style="list-style-type: none;">
                    <% lArray.forEach(item => { %>
                        <li>- &nbsp;&nbsp;<%= item %></li>
                    <% }); %>
                </ul>
            <% } %>

            <!-- Observaciones / Notas Generales -->
            <div class="font-bold" style="margin-bottom: 4px;">Notas en consulta:</div>
            <ul class="bullet-list" style="list-style-type: none;">
                <%
                   let notasArray = (plan.notasGenerales || "").split(/\r?\n/).filter(n => n.trim() !== '');
                   if (notasArray.length === 0) {
                       notasArray = (plan.notasClinicasRecientes || "").split(/\r?\n/).filter(n => n.trim() !== '');
                   }
                   if (notasArray.length > 0) {
                       notasArray.forEach(item => {
                %>
                    <li>- &nbsp;&nbsp;<strong><%= item.trim() %></strong></li>
                <%
                       });
                   } else {
                %>
                    <li>- &nbsp;&nbsp;Ninguna</li>
                <% } %>
            </ul>

            <% if (plan.notasLibresRecientes && plan.notasLibresRecientes.trim() !== "") { %>
                <div class="font-bold" style="margin-bottom: 4px;">Notas de entrenamiento:</div>
                <ul class="bullet-list" style="list-style-type: none;">
                    <% plan.notasLibresRecientes.split(/\r?\n/).filter(n => n.trim() !== '').forEach(item => { %>
                        <li>- &nbsp;&nbsp;<%= item.trim() %></li>
                    <% }); %>
                </ul>
            <% } %>

            <% if (plan.temarioReciente && plan.temarioReciente.length > 0) { %>
                <div class="font-bold" style="margin-bottom: 4px;">Temario abordado:</div>
                <ul class="bullet-list" style="list-style-type: none;">
                    <% plan.temarioReciente.forEach(tem => { %>
                        <li>- &nbsp;&nbsp;<strong><%= tem.tema %>:</strong> <%= tem.detalle %></li>
                    <% }); %>
                </ul>
            <% } %>

            <% if (meta.notaAmarilla && meta.notaAmarilla.trim() !== "") { %>
                <div style="text-align:center; margin: 20px 0;"><span class="highlight-yellow"><%= meta.notaAmarilla %></span></div>
            <% } %>

<% if (meta.showContacto === true) { %>
            <table style="width:100%; border-collapse: collapse; margin-bottom: 6px;">
                <tr>
                    <td style="width:50%; padding: 2px 8px; border-right: none; vertical-align: middle;">
                        <span style="font-weight:700; font-size:8.5px;">Correo: </span>
                        <span style="font-size:8.5px;"><%= meta.correoConsulta || paciente.email || '-' %></span>
                    </td>
                    <td style="width:50%; padding: 2px 8px; border-left: 1px solid #000; vertical-align: middle;">
                        <span style="font-weight:700; font-size:8.5px;">Tel: </span>
                        <span style="font-size:8.5px;"><%
                            const rawTel = (paciente.telefono || '').replace(/\D/g, '');
                            const tel10 = rawTel.length > 10 ? rawTel.slice(-10) : (rawTel || '-');
                        %><%= tel10 %></span>
                    </td>
                </tr>
            </table>
<% } %>

<% if (meta.showAlimentosEvitar !== false) { %>
            <%
                const evitarPrimeraHoja = Array.isArray(plan.evitarReciente) ? plan.evitarReciente : [];
                const evitarTexto = evitarPrimeraHoja.join(' · ');
                const evitarFontSize = evitarTexto.length > 700 ? 6.5 : evitarTexto.length > 350 ? 7.25 : 8.5;
            %>
            <div class="avoid-foods-summary" style="font-size: <%= evitarFontSize %>px;">
                <span class="avoid-foods-summary__title">Alimentos a evitar / No consume / No le gustan:</span>
                <% if (evitarPrimeraHoja.length > 0) { %>
                    <span><%= evitarTexto %></span>
                <% } else { %>
