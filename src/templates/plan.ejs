            ['Almendra','10 pz'], ['Nuez','3 pz'], ['Nuez de la india','7 pz'],
            ['Cacahuate','7 pz (20g)'], ['Pepita de calabaza','4 cditas (20g)'],
            ['Semilla de girasol','4 cditas (20g)'], ['Chía','5 cda (12g)'], ['Crema cacahuate','2 cdita (11g)']
        ];
        const rows2 = Math.max(b1.length, b2.length, b3.length, b4.length, b5.length);
        for (let i = 0; i < rows2; i++) {
        %>
        <tr>
            <td class="ic-nm"><%= b1[i] ? b1[i][0] : '' %></td><td class="ic-qty"><%= b1[i] ? b1[i][1] : '' %></td>
            <td class="ic-nm"><%= b2[i] ? b2[i][0] : '' %></td><td class="ic-qty"><%= b2[i] ? b2[i][1] : '' %></td>
            <td class="ic-nm"><%= b3[i] ? b3[i][0] : '' %></td><td class="ic-qty"><%= b3[i] ? b3[i][1] : '' %></td>
            <td class="ic-nm"><%= b4[i] ? b4[i][0] : '' %></td><td class="ic-qty"><%= b4[i] ? b4[i][1] : '' %></td>
            <td class="ic-nm"><%= b5[i] ? b5[i][0] : '' %></td><td class="ic-qty"><%= b5[i] ? b5[i][1] : '' %></td>
        </tr>
        <% } %>
    </table>

    <!-- ═══ Abreviaciones ═══════════════════════════════════════════════════ -->
    <table class="ic-tbl ic-abbr">
        <%
            const abreviaciones = [['IMC','índice de masa corporal'],['MLG','masa libre de grasa'],['Eq','equivalentes'],['AOA','alimentos de origen animal'],['Cdita','cucharadita'],['Cda','cucharada'],['Dn','desnutrición'],['Nr','normal (peso)'],['Sp','sobrepeso'],['Ob','obesidad']];
            const abbrCols = 3;
            const abbrRows = Math.ceil(abreviaciones.length / abbrCols);
        %>
        <tr><td colspan="3" class="ic-title">Abreviaciones</td></tr>
        <% for (let r = 0; r < abbrRows; r++) { %>
        <tr>
            <% for (let c = 0; c < abbrCols; c++) { const ab = abreviaciones[r * abbrCols + c]; %>
            <td style="width: <%= (100 / abbrCols).toFixed(0) %>%;"><% if (ab) { %><span style="color: #111; font-weight: 500;"><%= ab[0] %>:</span> <span style="color: #444; font-weight: 400; font-size: 6.8px;"><%= ab[1] %></span><% } %></td>
            <% } %>
        </tr>
        <% } %>
    </table>
</div>
<% } %>


<!-- PAGE 4: EXTRAS -->
<% if (showExtras) { %>
<div class="page extras-page">
    <%- headerHTML %>
    
    <% if (meta.showDistribucionPorciones !== false && plan.menus && plan.menus.length > 0) { %>
        <div class="section-title">Distribución de porciones en el día</div>
        <div class="extras-distribution-grid" style="display: flex; gap: 20px; margin-bottom: 25px; flex-wrap: wrap;">
            <% plan.menus.forEach(menu => { %>
                <div class="extras-distribution-card" style="border: 1px solid #000; width: calc(50% - 10px); box-sizing: border-box; margin-bottom: 10px;">
                    <div class="extras-distribution-title" style="text-align: center; font-weight: 800; font-size: 14px; padding: 6px 0; border-bottom: 1px solid #000;">
                        <%= menu.nombre %>
                    </div>
                    <table class="extras-distribution-table" style="width: 100%; border-collapse: collapse; font-size: 11px;">
                        <thead>
                            <tr>
                                <th style="border: none; border-bottom: 1px solid #000; border-right: 1px solid #000; text-align: left; padding: 4px 8px; font-weight: bold; background: transparent;">ALIMENTOS</th>
                                <th style="border: none; border-bottom: 1px solid #000; text-align: left; padding: 4px 8px; font-weight: bold; background: transparent;">PORCIONES</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% 
                               const mapGroupToLabel = (g) => {
                                 const low = (g || '').toLowerCase();
                                 if (low.includes('fruta')) return 'Frutas';
                                 if (low === 'c y t sin grasa' || low === 'cereal sin grasa' || low.includes('cereal s/grasa')) return 'Cereal sin grasa';
                                 if (low === 'c y t con grasa' || low === 'cereal con grasa' || low.includes('cereal c/grasa')) return 'Cereal con grasa';
                                 if (low.includes('leguminosa')) return 'Leguminosas';
                                 if (low === 'aoa muy bajo' || low.includes('muy bajo')) return 'AOA mb';
                                 if (low === 'aoa bajo' || (low.includes('aoa') && low.includes('bajo') && !low.includes('muy'))) return 'AOA b';
                                 if (low === 'aoa moderado' || low.includes('moderado')) return 'AOA moderado';
                                 if (low === 'aoa alto' || (low.includes('aoa') && low.includes('alto'))) return 'AOA alto';
                                 if (low.includes('leche')) return 'Leche';
                                 if (low === 'a y g sin proteína' || low === 'grasa sin proteína' || low.includes('grasa s/prot')) return 'Grasa sin proteína';
                                 if (low === 'a y g con proteína' || low === 'grasa con proteína' || low.includes('grasa c/prot')) return 'Grasa con proteína';
                                 if (low === 'az sin grasa' || low === 'azúcar sin grasa' || low.includes('azúcar s')) return 'Azúcar sin grasa';
                                 if (low === 'az con grasa' || low === 'azúcar con grasa' || low.includes('azúcar c')) return 'Azúcar con grasa';
                                 if (low.includes('verdura')) return 'Verduras';
                                 return g;
                               };

                               const gruposOrden = [
                                 'Verduras',
                                 'Frutas',
                                 'Cereal sin grasa',
                                 'Cereal con grasa',
                                 'Leguminosas',
                                 'AOA mb',
                                 'AOA b',
                                 'AOA moderado',
                                 'AOA alto',
                                 'Leche',
                                 'Grasa sin proteína',
                                 'Grasa con proteína',
                                 'Azúcar sin grasa',
                                 'Azúcar con grasa'
                               ];

                               const agregados = {};
                               if (menu.tiemposComida) {
                                   menu.tiemposComida.forEach(t => {
                                       if (t.ingredientes) {
                                           t.ingredientes.forEach(ing => {
                                               if (ing.eqGrupo && ing.eqCantidad) {
                                                   const mapped = mapGroupToLabel(ing.eqGrupo);
                                                   agregados[mapped] = (agregados[mapped] || 0) + Number(ing.eqCantidad);
                                               }
                                           });
                                       }
                                   });
                               }
                            %>
                            <% gruposOrden.forEach((gLabel, index) => { 
                               const qty = agregados[gLabel];
                               const isLast = index === gruposOrden.length - 1;
                               const borderBottom = isLast ? '' : 'border-bottom: 1px solid #000;';
                            %>
                                <tr>
                                    <td style="border: none; <%= borderBottom %> border-right: 1px solid #000; padding: 4px 8px; font-weight: normal;"><%= gLabel %></td>
                                    <td style="border: none; <%= borderBottom %> padding: 4px 8px; font-weight: normal;"><%= qty ? qty : '-' %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% }); %>
        </div>
    <% } %>

    <div class="section-title">Esquema de suplementación:</div>
    <% if (plan.suplementosTabla && plan.suplementosTabla.length > 0) { %>
        <table class="supl-table">
            <thead>
                <tr>
                    <th>Suplemento</th>
                    <th>Indicaciones</th>
                    <th>Estado</th>
                    <th>Tiempo de uso</th>
                </tr>
            </thead>
            <tbody>
                <% plan.suplementosTabla.forEach(sup => { %>
                    <tr class="<%= sup.activo ? '' : 'supl-row-suspended' %>">
                        <td><%= sup.nombre %></td>
                        <td><%= sup.indicaciones %></td>
                        <td><span class="<%= sup.activo ? 'supl-activo' : 'supl-suspendido' %>"><%= sup.estado %></span></td>
                        <td><%= sup.duracion || '-' %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } else { %>
        <table style="width: 250px;">
            <% (plan.suplementacionReciente || meta.suplementacion || ["-", "-"]).forEach(sup => { %>
                <tr><td><%= sup %></td></tr>
            <% }); %>
        </table>
    <% } %>

    <div class="section-title">Esquema de hidratación:</div>
    <table class="data-table">
        <% if (plan.esqueHidratacionReciente) { %>
            <tr><td style="white-space: pre-wrap;"><%= plan.esqueHidratacionReciente %></td></tr>
        <% } else { %>
            <tr><td style="color: #888; font-style: italic;">Sin indicaciones específicas.</td></tr>
        <% } %>
    </table>

    <% if (meta.estrategiaMaraton && meta.estrategiaMaraton.mostrar !== false) { %>
        <div class="section-title"><span class="highlight-yellow"><%= meta.estrategiaMaraton.titulo || 'Estrategia para 1/2 maraton' %></span></div>
        <table>
            <% (meta.estrategiaMaraton.filas || [["35 min", "1er gel"], ["1:10 hr", "2do gel"], ["1:45 hr hr", "3er gel + cafeina"]]).forEach(fila => { %>
                <tr>
                    <td style="width: 120px;"><%= fila[0] %></td>
                    <td><%= fila[1] %></td>
                </tr>
            <% }); %>
        </table>
    <% } %>

    <% if (plan.competenciaReciente) { %>
        <div class="section-title">Notas de competencia:</div>
        <table style="width: 450px;">
            <% (['antes', 'durante', 'despues']).forEach(fase => { if (plan.competenciaReciente[fase]) { %>
                <tr><td style="width: 90px;"><strong><%= fase === 'antes' ? 'Antes' : fase === 'durante' ? 'Durante' : 'Después' %>:</strong></td><td><%= plan.competenciaReciente[fase] %></td></tr>
            <% } }); %>
        </table>
    <% } %>
</div>
<% } %>

<% if (Array.isArray(plan.spellingPreviewIssues) && plan.spellingPreviewIssues.length > 0) { %>
<script>
    (() => {
        const issueWords = <%- JSON.stringify(plan.spellingPreviewIssues.map(issue => issue.word)).replace(/</g, '\\u003c') %>;
        const normalizedIssues = new Set(issueWords.map(word => word.toLocaleLowerCase('es-MX')));
        const wordPattern = /[\p{L}]+(?:[’'-][\p{L}]+)*/gu;
        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
            acceptNode(node) {
                const parent = node.parentElement;
                if (!parent || parent.closest('script, style, .proper-name, .spelling-preview-error')) return NodeFilter.FILTER_REJECT;
                wordPattern.lastIndex = 0;
                return wordPattern.test(node.nodeValue || '') ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
            }
        });
        const nodes = [];
        while (walker.nextNode()) nodes.push(walker.currentNode);

        nodes.forEach(node => {
            const text = node.nodeValue || '';
            const fragment = document.createDocumentFragment();
            let cursor = 0;
            let hasIssue = false;
            wordPattern.lastIndex = 0;

            for (const match of text.matchAll(wordPattern)) {
                const word = match[0];
                const index = match.index || 0;
                fragment.append(document.createTextNode(text.slice(cursor, index)));
                if (normalizedIssues.has(word.toLocaleLowerCase('es-MX'))) {
                    const marker = document.createElement('span');
                    marker.className = 'spelling-preview-error';
                    marker.textContent = word;
                    fragment.append(marker);
                    hasIssue = true;
                } else {
                    fragment.append(document.createTextNode(word));
                }
                cursor = index + word.length;
            }
            fragment.append(document.createTextNode(text.slice(cursor)));
            if (hasIssue) node.replaceWith(fragment);
        });
    })();
</script>
<% } %>

</body>
</html>
