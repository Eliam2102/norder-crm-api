                                    ? ing.equivalencias.filter(e => e.grupo && String(e.grupo).trim() !== '' && e.cantidad !== '' && e.cantidad != null)
                                    : (ing.eqCantidad && ing.eqGrupo ? [{ cantidad: ing.eqCantidad, grupo: ing.eqGrupo }] : []);
                                const eqsM1 = eqsM1Raw.filter(e => parseFloat(e.cantidad) > 0);
                                const eqStrM1 = eqsM1.map(e => `${e.cantidad} eq ${e.grupo}`).join(' + ');
