<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Plan Nutricional - <%= paciente.nombre %></title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
        
        @page {
            size: A4 landscape;
            margin: 0;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
        
        body {
            background-color: #fff;
            color: #000;
            font-size: 9px;
        }

        .page {
            width: 297mm;
            min-height: 210mm;
            padding: 15mm 18mm;
            position: relative;
            page-break-after: always;
            background: #fff;
        }

        /* HEADER */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }
        .header-logo {
            font-size: 32px;
            font-weight: 800;
            color: #7b8898;
            letter-spacing: -1px;
            line-height: 1;
        }
        .header-logo img {
            width: 140px;
            height: auto;
            object-fit: contain;
            display: block;
        }
        .header-logo span {
            display: block;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 4px;
            color: #a0a0a0;
            margin-top: 4px;
        }
        .header-info {
            text-align: right;
            font-size: 9px;
            color: #333;
            line-height: 1.4;
        }
        .header-info strong {
            font-size: 10px;
            color: #000;
        }

        /* TITLE */
        .title-name {
            font-size: 16px;
            font-weight: 800;
            margin-bottom: 15px;
            color: #000;
        }

        /* TABLES */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
        }
        th, td {
            border: 1px solid #000;
            padding: 5px 8px;
            font-size: 10px;
            text-align: left;
            vertical-align: top;
        }
        th {
            font-weight: 700;
            background-color: #fff;
        }
        .text-center { text-align: center; }
        .font-bold { font-weight: 700; }
        .bg-gray { background-color: #f5f5f5; }

        /* HIGHLIGHTS */
        .highlight-yellow {
            background-color: #ffff00;
            font-weight: bold;
            display: inline-block;
            padding: 2px 4px;
        }

        /* LISTS */
        .bullet-list { margin-left: 15px; margin-bottom: 15px; }
        .bullet-list li { margin-bottom: 4px; }

        /* CUSTOM SECTIONS */
        .section-title {
            font-size: 12px;
            font-weight: 800;
            margin-bottom: 8px;
            margin-top: 15px;
        }

        .side-images {
            width: 125px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            align-items: flex-end;
            padding-left: 0;
            overflow: visible;
        }
        .side-images img {
            width: 240px;
            max-width: none;
            height: auto;
            object-fit: contain;
            object-position: right top;
            margin-top: -12px;
            transform: translateX(60px);
        }

        /* MENU GRID */
        .menu-grid {
            border: 1px solid #000;
            width: 100%;
        }
        .menu-row {
            display: flex;
            border-bottom: 1px solid #000;
            min-height: 40px;
            page-break-inside: avoid; /* Evitar que un tiempo de comida se parta en 2 hojas */
        }
        .menu-row:last-child { border-bottom: none; }
        .menu-col {
            flex: 1;
            border-right: 1px solid #000;
            padding: 6px;
        }
        .menu-col:last-child { border-right: none; }
        .menu-time { font-weight: bold; text-transform: uppercase; margin-bottom: 4px; font-size: 10px; }
        .menu-time-subtitle { font-weight: normal; text-transform: none; font-size: 8px; display: block; margin-top: 1px; }
        .menu-item { margin-bottom: 3px; padding-left: 8px; position: relative; font-size: 8.5px; }
        .menu-item:before { content: "-"; position: absolute; left: 0; }
        .menu-water { margin-top: 8px; font-size: 9px; }
    </style>
</head>
<body>

<% 
    // SETUP VARIABLES
    const meta = plan.pdfCustomMeta || {};
    const showHistorial = meta.showPageHistorial !== false;
    const showMenus = meta.showPageMenus !== false;
    const showIntercambio = meta.showPageIntercambio !== false;
    const showExtras = meta.showPageExtras !== false;
    
    // Setup menus map to split into Menu 1 and Menu 2 if they exist
    const menu1 = plan.menus && plan.menus[0] ? plan.menus[0] : null;
    const menu2 = plan.menus && plan.menus[1] ? plan.menus[1] : null;

    // Get all distinct times from menus to draw rows
    // Get all distinct times from menus to draw rows based on base meal name
    let timeNames = [];
    if (menu1) menu1.tiemposComida.forEach(t => { 
        const baseName = t.nombre.split('.')[0].trim();
        if (!timeNames.includes(baseName)) timeNames.push(baseName); 
    });
    if (menu2) menu2.tiemposComida.forEach(t => { 
        const baseName = t.nombre.split('.')[0].trim();
        if (!timeNames.includes(baseName)) timeNames.push(baseName); 
    });
    
    // Sort valoraciones chronologically (oldest to newest) for the history table
    // We use the 'valoraciones' variable passed explicitly by the backend payload
    const hist = Array.isArray(valoraciones) ? valoraciones.slice().reverse() : []; 
    // Fill up to 7 columns
    const cols = Array(7).fill(null);
    hist.forEach((v, i) => { if (i < 7) cols[i] = v; });

    const headerHTML = `
        <div class="header">
            <div class="header-logo">
                ${logoMenuImg ? '<img src="' + logoMenuImg + '" alt="Norder">' : 'NORDER<span>THINK · EAT · LIVE</span>'}
            </div>
            <div class="header-info">
                <strong>L.N. Eyder Méndez Gamboa</strong><br>
                Certificación ISAK Nivel 2<br><br>
                +52 999 127 61 29 / consultas@norder.mx<br>
                <strong>VIA "Vida Integral y Asesoría Profesional"</strong><br>
                999 292 1130 / Calle 40 #278 G, Campestre C.P. 97120. Mérida, Yucatán.
            </div>
        </div>
    `;
%>

<!-- PAGE 1: HISTORIAL -->
<% if (showHistorial) { %>
<div class="page">
    <%- headerHTML %>
    <!-- Layout flex: contenido a la izquierda + imagen tipos de cuerpo a la derecha -->
    <div style="display: flex; gap: 8px; align-items: flex-start;">
        <!-- Columna izquierda: contenido -->
        <div style="flex: 1; min-width: 0;">
            <div class="title-name">Nombre: <%= paciente.nombre %> <%= paciente.apellido || '' %></div>
            
            <table>
                <tr>
                    <td class="font-bold">Fecha</td>
                    <% cols.forEach(c => { 
                        let fStr = '';
                        if (c) {
                            try {
                                const raw = c.fecha instanceof Date ? c.fecha.toISOString() : String(c.fecha);
                                const d = new Date(raw.split('T')[0] + 'T12:00:00');
                                fStr = d.toLocaleDateString("es-MX", { day: "2-digit", month: "2-digit", year: "2-digit" });
                            } catch (e) { fStr = String(c.fecha); }
                        }
                    %>
                        <td><%= fStr %></td>
                    <% }); %>
                </tr>
                <tr>
                    <td class="font-bold">Objetivo</td>
                    <% cols.forEach(c => { %>
                        <td><%= c && c.objetivo ? c.objetivo : '' %></td>
                    <% }); %>
                </tr>
                <tr><td colspan="8" class="font-bold text-center">Resultados Generales</td></tr>
                <tr>
                    <td class="font-bold">Peso</td>
                    <% cols.forEach(c => { %><td><%= (c && c.pesoActual != null) ? c.pesoActual : '' %></td><% }); %>
                </tr>
                <tr>
                    <td class="font-bold">Talla (cm)</td>
                    <% cols.forEach(c => { %><td><%= (c && c.estatura != null) ? c.estatura : '' %></td><% }); %>
                </tr>
                <tr><td colspan="8" class="font-bold text-center">Resultados Antropométricos</td></tr>
                <tr>
                    <td class="font-bold">% Grasa</td>
                    <% cols.forEach(c => { %><td><%= (c && c.pctGrasaCorp != null) ? c.pctGrasaCorp : '' %></td><% }); %>
                </tr>
                <tr>
                    <td class="font-bold">Kg Grasa</td>
                    <% cols.forEach(c => { %><td><%= (c && c.masaGrasaReal != null) ? c.masaGrasaReal : '' %></td><% }); %>
                </tr>
                <tr>
                    <td class="font-bold">Kg MLG</td>
                    <% cols.forEach(c => { %><td><%= (c && c.masaMagra != null) ? c.masaMagra : '' %></td><% }); %>
                </tr>
                <tr>
                    <td class="font-bold">Somatotipo</td>
                    <% cols.forEach(c => { %><td><%= (c && c.somatotipo) ? c.somatotipo : '' %></td><% }); %>
                </tr>
                <tr>
                    <td class="font-bold">Energía(kcal)</td>
                    <% cols.forEach(c => { %><td><%= (c && c.energia != null) ? c.energia : '' %></td><% }); %>
                </tr>
            </table>

            <!-- Lineamientos -->
            <div class="font-bold" style="margin-bottom: 4px;">Lineamientos:</div>
            <ul class="bullet-list" style="list-style-type: none;">
                <% 
                   const lineamientosDefault = ["Aprender porciones","Consumo de agua mínimo 2.5 lts, no se considera el líquido consumido en el entrenamiento","Importante consumir vegetales en desayuno, almuerzo y cena.","Pesar y medir los alimentos (cocidos)","Visita www.norder.mx para conocer nuestras marcas afiliadas."];
                   const lArray = plan.lineamientosRecientes || meta.lineamientos || lineamientosDefault;
                   lArray.forEach(item => { 
                %>
                    <li>- &nbsp;&nbsp;<%= item %></li>
                <% }); %>
            </ul>

            <!-- Observaciones / Notas Generales -->
            <div class="font-bold" style="margin-bottom: 4px;">Observaciones:</div>
            <ul class="bullet-list" style="list-style-type: none;">
                <% 
                   const notasArray = (plan.notasGenerales || "").split(/\r?\n/).filter(n => n.trim() !== '');
                   if (notasArray.length > 0) {
                       notasArray.forEach(item => { 
                %>
                    <li>- &nbsp;&nbsp;<strong><%= item.trim() %></strong></li>
                <% 
                       });
                   } else { 
                %>
                    <li>- &nbsp;&nbsp;Ninguna</li>
                <% } %>
            </ul>

            <% if (meta.notaAmarilla && meta.notaAmarilla.trim() !== "") { %>
                <div style="text-align:center; margin: 20px 0;"><span class="highlight-yellow"><%= meta.notaAmarilla %></span></div>
            <% } %>

            <table>
                <tr><td class="font-bold" style="width:80px;">Evitar:</td><td><%= meta.evitar || '-' %></td></tr>
                <tr><td class="font-bold">Correo:</td><td><%= meta.correoConsulta || paciente.email || '-' %></td></tr>
            </table>
        </div>

        <!-- Columna derecha: Guía Tipos de Cuerpo HTML nativo -->
        <!-- Columna derecha: Imagen Tipos de Cuerpo, alineada y agrandada -->
        <div class="side-images">
            <% if (tiposCuerpoImg) { %>
                <img src="<%= tiposCuerpoImg %>" alt="Tipos de cuerpo">
            <% } else { %>
                <div style="font-size:8px; font-weight:bold; color:#aaa; text-align:center; padding:10px 4px;">[Tipos de cuerpo]</div>
            <% } %>
        </div>
    </div>
</div>
<% } %>


<!-- PAGE 2: MENUS -->
<% if (showMenus) { %>
<div class="page">
    <%- headerHTML %>
    
    <div class="menu-grid">
        <div class="menu-row">
            <div class="menu-col text-center font-bold">MENÚ #1</div>
            <div class="menu-col text-center font-bold">MENÚ #2</div>
        </div>
        
        <% 
        timeNames.forEach(tName => { 
            const tMenu1 = menu1 ? menu1.tiemposComida.find(t => t.nombre.split('.')[0].trim() === tName) : null;
            const tMenu2 = menu2 ? menu2.tiemposComida.find(t => t.nombre.split('.')[0].trim() === tName) : null;
        %>
        <div class="menu-row">
            <!-- Menú 1 -->
            <div class="menu-col">
                <div class="menu-time">
                    <%= tName %>
                    <% if(meta[`menu1_titulo`]) { %> <%= meta[`menu1_titulo`] %> <% } %>
                </div>
                
                <% if(tMenu1 && tMenu1.ingredientes && tMenu1.ingredientes.length > 0) { 
                    const grouped1 = {};
                    tMenu1.ingredientes.forEach(ing => {
                        const plat = ing.platillo || '';
                        if(!grouped1[plat]) grouped1[plat] = [];
                        grouped1[plat].push(ing);
                    });
                    
                    Object.keys(grouped1).forEach(plat => {
                        if (plat && !meta.soloEquivalencias) { %>
                            <div style="font-size:9px; font-weight:bold; margin-top:5px; margin-bottom:2px; color:#444; text-transform:uppercase;"><%= plat %></div>
                        <% }
                        grouped1[plat].forEach(ing => { %>
                        <div class="menu-item">
                            <% if (meta.soloEquivalencias) { %>
                                <% if(ing.eqCantidad && ing.eqGrupo) { %>
                                    • <%= ing.eqCantidad %> eq <%= ing.eqGrupo %>
                                <% } %>
                            <% } else { %>
                                <%= ing.descripcion %> - <%= ing.cantidad %> <%= ing.unidad %> 
                                <% if(ing.eqCantidad && ing.eqGrupo) { %>
                                    (<%= ing.eqCantidad %> eq <%= ing.eqGrupo %>)
                                <% } %>
                            <% } %>
                        </div>
                    <%  });
                    }); %>
                <% } else { %>
                    <div class="menu-item text-center" style="color:#aaa; font-style:italic; margin-top:20px;">Sin platillo</div>
                <% } %>
                
                <% if(tMenu1 && tMenu1.notaPie) { %>
                    <div class="menu-water"><%= tMenu1.notaPie %></div>
                <% } %>
            </div>
            
            <!-- Menú 2 -->
            <div class="menu-col">
                <div class="menu-time">
                    <%= tName %>
                    <% if(meta[`menu2_titulo`]) { %> <%= meta[`menu2_titulo`] %> <% } %>
                </div>
                
                <% if(tMenu2 && tMenu2.ingredientes && tMenu2.ingredientes.length > 0) { 
                    const grouped2 = {};
                    tMenu2.ingredientes.forEach(ing => {
                        const plat = ing.platillo || '';
                        if(!grouped2[plat]) grouped2[plat] = [];
                        grouped2[plat].push(ing);
                    });
                    
                    Object.keys(grouped2).forEach(plat => {
                        if (plat && !meta.soloEquivalencias) { %>
                            <div style="font-size:9px; font-weight:bold; margin-top:5px; margin-bottom:2px; color:#444; text-transform:uppercase;"><%= plat %></div>
                        <% }
                        grouped2[plat].forEach(ing => { %>
                        <div class="menu-item">
                            <% if (meta.soloEquivalencias) { %>
                                <% if(ing.eqCantidad && ing.eqGrupo) { %>
                                    • <%= ing.eqCantidad %> eq <%= ing.eqGrupo %>
                                <% } %>
                            <% } else { %>
                                <%= ing.descripcion %> - <%= ing.cantidad %> <%= ing.unidad %> 
                                <% if(ing.eqCantidad && ing.eqGrupo) { %>
                                    (<%= ing.eqCantidad %> eq <%= ing.eqGrupo %>)
                                <% } %>
                            <% } %>
                        </div>
                    <%  });
                    }); %>
                <% } else { %>
                    <div class="menu-item text-center" style="color:#aaa; font-style:italic; margin-top:20px;">Sin platillo</div>
                <% } %>

                <% if(tMenu2 && tMenu2.notaPie) { %>
                    <div class="menu-water"><%= tMenu2.notaPie %></div>
                <% } %>
            </div>
        </div>
        <% }); %>

        <div class="menu-row" style="min-height:20px; text-align:right;">
            <div style="padding: 5px 15px; width:100%; font-size:11px;">
                <i>Próxima sesión:</i> &nbsp;&nbsp;&nbsp;&nbsp;<strong><%= plan.proximaSesion ? new Date(plan.proximaSesion).toLocaleString("es-MX", {day:"2-digit", month:"long", year:"numeric", hour:"2-digit", minute:"2-digit", hour12:true}).replace(',', ' a las') : (meta.proximaSesionTexto || 'Pendiente') %></strong>
            </div>
        </div>
    </div>
</div>
<% } %>


<!-- PAGE 3: LISTA INTERCAMBIO -->
<% if (showIntercambio) { %>
<div class="page">
    <%- headerHTML %>
    <style>
        .ic-tbl {
            width: 100%;
            border-collapse: collapse;
            font-size: 7.5px;
            table-layout: fixed;
            page-break-inside: avoid;
            margin-bottom: 4px;
        }
        .ic-tbl td, .ic-tbl th {
            border: 1px solid #000;
            padding: 1px 2.5px;
            vertical-align: middle;
            overflow: hidden;
        }
        .ic-tbl .ic-title {
            font-weight: bold;
            text-align: center;
            font-size: 11px;
            padding: 2px;
        }
        /* Cabeceras de columna "Grupo / Porción(1)" */
        .ic-tbl .ic-col-hdr {
            font-weight: 800;
            font-size: 8px;
            color: #444;
            text-transform: uppercase;
            background: #f0f0f0;
            padding: 2px;
        }
        /* Nombre del grupo (Verduras, Frutas...) */
        .ic-tbl .ic-grp {
            font-weight: 800;
            font-size: 8.5px;
            color: #000;
            background: #e9eff5;
            text-transform: uppercase;
            padding: 2.5px 2px;
        }
        /* Celda de nombre de alimento */
        .ic-tbl .ic-nm  { 
            font-weight: 600; 
            color: #222;
        }
        /* Celda de porción */
        .ic-tbl .ic-qty { 
            font-weight: 500;
            color: #3b5973; 
        }
        /* Sección abreviaciones */
        .ic-abbr {
            width: 100%;
            border-collapse: collapse;
            font-size: 7.5px;
            table-layout: fixed;
            margin-top: 3px;
            page-break-inside: avoid;
        }
        .ic-abbr td { border: 1px solid #000; padding: 1.5px 3px; vertical-align: top; }
        .ic-abbr .abbr-hdr { font-weight: bold; background: #f0f0f0; font-size: 8px; padding: 2px; }
    </style>

    <!-- ═══ Tabla principal ═══════════════════════════════════════════════════ -->
    <table class="ic-tbl">
        <col style="width:9%"><col style="width:5%">
        <col style="width:9%"><col style="width:5%">
        <col style="width:9%"><col style="width:5%">
        <col style="width:8%"><col style="width:4%">
        <col style="width:8%"><col style="width:4%">

        <!-- Título -->
        <tr>
            <td colspan="10" class="ic-title">Lista de intercambio de alimentos</td>
        </tr>

        <!-- Cabeceras columnas: Grupo | Porción(1) × 5 -->
        <tr>
            <td class="ic-col-hdr">Grupo</td><td class="ic-col-hdr">Porción(1)</td>
            <td class="ic-col-hdr">Grupo</td><td class="ic-col-hdr">Porción(1)</td>
            <td class="ic-col-hdr">Grupo</td><td class="ic-col-hdr">Porción(1)</td>
            <td class="ic-col-hdr">Grupo</td><td class="ic-col-hdr">Porción(1)</td>
            <td class="ic-col-hdr">Grupo</td><td class="ic-col-hdr">Porción(1)</td>
        </tr>

        <!-- ── BLOQUE 1: Verduras / Frutas / Cereales / Legumbres / Leche ──── -->
        <tr>
            <td colspan="2" class="ic-grp">Verduras</td>
            <td colspan="2" class="ic-grp">Frutas</td>
            <td colspan="2" class="ic-grp">Cereales sin grasa</td>
            <td colspan="2" class="ic-grp">Legumbres</td>
            <td colspan="2" class="ic-grp">Leche</td>
        </tr>
        <%
        const g1 = [
            ['Brócoli','libre'], ['Calabaza','libre'], ['Cebolla','libre'], ['Chayote','libre'],
            ['Tomate','libre'], ['Jícama','libre'], ['Pepino','libre'], ['Zanahoria','libre'],
            ['Espárrago','libre'], ['Champiñón','libre']
        ];
        const g2 = [
            ['Manzana','1 pz (106g)'], ['Pera','½ pz (77g)'], ['Naranja/mandarina','2 pz (150g)'],
            ['Papaya','1 tz (140g)'], ['Fresa','1 tz (204g)'], ['Piña','¾ tz (124g)'],
            ['Uva','18 pz (86g)'], ['Toronja','1 pz (62g)'], ['Plátano','½ pz (50g)'], ['Mango','½ pz (145g)']
        ];
        const g3 = [
            ['Arroz','¼ tz (50g)'], ['Avena','1/3 tz (30g)'], ['Cereal (bajo en azúcar)','1/3 tz (20gr)'],
            ['Elote','½ tz (80g)'], ['Pasta','1/3 tz (20g)'], ['Palomitas','2 ½ tz (18g)'],
            ['Papa','½ pz (100gr)'], ['Camote','1/7 pz (49g)'], ['Tortilla maíz','1 pz (30g)'], ['Tortilla nopal','2 pz (30gr)']
        ];
        const g4 = [
            ['Frijol','½ tz (80g)'], ['Habas','½ tz (80g)'], ['Lenteja','½ tz (80g)'],
            ['Garbanzo (hummus)','½ tz (80g)'], ['Alubias','½ tz (80g)'], ['Soya cocida','1/3 tz (57g)']
        ];
        const g5 = [
            ['Vaca light','240 ml'], ['Coco','240 ml'], ['Almendra','240 ml'],
            ['Soya','240 ml'], ['Yogurt natural (Vitalinea)','¾ tz (180g)']
        ];
        const rows1 = Math.max(g1.length, g2.length, g3.length, g4.length, g5.length);
        for (let i = 0; i < rows1; i++) {
        %>
        <tr>
            <td class="ic-nm"><%= g1[i] ? g1[i][0] : '' %></td><td class="ic-qty"><%= g1[i] ? g1[i][1] : '' %></td>
            <td class="ic-nm"><%= g2[i] ? g2[i][0] : '' %></td><td class="ic-qty"><%= g2[i] ? g2[i][1] : '' %></td>
            <td class="ic-nm"><%= g3[i] ? g3[i][0] : '' %></td><td class="ic-qty"><%= g3[i] ? g3[i][1] : '' %></td>
            <td class="ic-nm"><%= g4[i] ? g4[i][0] : '' %></td><td class="ic-qty"><%= g4[i] ? g4[i][1] : '' %></td>
            <td class="ic-nm"><%= g5[i] ? g5[i][0] : '' %></td><td class="ic-qty"><%= g5[i] ? g5[i][1] : '' %></td>
        </tr>
        <% } %>

        <!-- ── BLOQUE 2: AOAmb / AOAb / AOAm / AYGsp / AYGcp ──────────────── -->
        <tr>
            <td colspan="2" class="ic-grp" style="font-size:7px;">Alimento de origen animal<br>muy bajo en grasa (AOAmb)</td>
            <td colspan="2" class="ic-grp" style="font-size:7px;">Alimento de origen animal<br>bajo en grasa (AOAb)</td>
            <td colspan="2" class="ic-grp" style="font-size:7px;">Alimento de origen animal<br>moderado en grasa (AOAm)</td>
            <td colspan="2" class="ic-grp" style="font-size:7px;">Aceites y grasas sin proteína<br>(AYGsp)</td>
            <td colspan="2" class="ic-grp" style="font-size:7px;">Aceites y grasas con proteína<br>(AYGcp)</td>
        </tr>
        <%
        const b1 = [
            ['Pechuga pollo','30g'], ['Clara de huevo','2 pz (2oz)'], ['Camarón cocido','5 pz (35g)'],
            ['Pulpo (cocido)','30gr'], ['Molida de pollo','32 g'], ['Atún','33g'],
            ['Pescado','40g'], ['Salmón','40g'], ['Queso cottage light','3 cda (50g)'], ['Bistec magro 90/10','30g']
        ];
        const b2 = [
            ['Cerdo (lomo, pierna)','40 g'], ['Res (pulpa, milanesa)','30 g'], ['Jamón de pavo','2 reb (42g)'],
            ['Pollo con piel','30 g'], ['Queso panela','40 g'], ['Pavo','45 g'],
            ['Queso Oaxaca light','30 g'], ['Queso ricota','45 g'], ['Tofu','40 g']
        ];
        const b3 = [
            ['Huevo entero','1 pz'], ['Salchicha cerdo','1 pz'], ['Longaniza','45 g'],
            ['Queso mozzarella','30 g'], ['Queso parmesano','3 ½ cda (55g)'],
            ['Queso monterrey','28g'], ['Queso tipo americano','30g'], ['Salami de pavo','42g']
        ];
        const b4 = [
            ['Ac. Oliva, aguacate, girasol','1 cdita (5g)'], ['Aderezo (en general)','1 cdita (5g)'],
            ['Aguacate','⅓ pz (30g)'], ['Coco rallado','1 ½ cda (20g)'],
            ['Mantequilla','1 ½ cda'], ['Margarina','1 cda'], ['Tocino','1 reb (8g)']
        ];
        const b5 = [
            ['Almendra','10 pz'], ['Nuez','3 pz'], ['Nuez de la india','7 pz'],
            ['Cacahuate','7 pz (20g)'], ['Pepita de calabaza','4 cditas (20g)'],
            ['Semilla de girasol','4 cditas (20g)'], ['Chía','5 cda (12g)'], ['Crema cacahuate','2 cdita (11g)']
        ];
        const rows2 = Math.max(b1.length, b2.length, b3.length, b4.length, b5.length);
        for (let i = 0; i < rows2; i++) {
        %>
        <tr>
            <td class="ic-nm"><%= b1[i] ? b1[i][0] : '' %></td><td class="ic-qty"><%= b1[i] ? b1[i][1] : '' %></td>
            <td class="ic-nm"><%= b2[i] ? b2[i][0] : '' %></td><td class="ic-qty"><%= b2[i] ? b2[i][1] : '' %></td>
            <td class="ic-nm"><%= b3[i] ? b3[i][0] : '' %></td><td class="ic-qty"><%= b3[i] ? b3[i][1] : '' %></td>
            <td class="ic-nm"><%= b4[i] ? b4[i][0] : '' %></td><td class="ic-qty"><%= b4[i] ? b4[i][1] : '' %></td>
            <td class="ic-nm"><%= b5[i] ? b5[i][0] : '' %></td><td class="ic-qty"><%= b5[i] ? b5[i][1] : '' %></td>
        </tr>
        <% } %>
    </table>

    <!-- ═══ Abreviaciones ═══════════════════════════════════════════════════ -->
    <table class="ic-abbr">
        <tr><td colspan="3" class="abbr-hdr">Abreviaciones</td></tr>
        <tr>
            <td><strong>IMC:</strong> índice de masa corporal<br><strong>MLG:</strong> masa libre de grasa</td>
            <td><strong>Eq:</strong> equivalentes<br><strong>AOA:</strong> alimentos de origen animal<br><strong>Cdita:</strong> cucharadita &nbsp; <strong>Cda:</strong> cucharada</td>
            <td><strong>Dn:</strong> desnutrición<br><strong>Nr:</strong> normal (peso)<br><strong>Sp:</strong> sobrepeso &nbsp; <strong>Ob:</strong> obesidad</td>
        </tr>
    </table>
</div>
<% } %>


<!-- PAGE 4: EXTRAS -->
<% if (showExtras) { %>
<div class="page">
    <%- headerHTML %>
    
    <div class="section-title">Esquema de suplementación:</div>
    <table style="width: 250px;">
        <% (plan.suplementacionReciente || meta.suplementacion || ["-", "-"]).forEach(sup => { %>
            <tr><td><%= sup %></td></tr>
        <% }); %>
    </table>

    <div class="section-title">Esquema de hidratación:</div>
    <table style="width: 250px;">
        <% (plan.hidratacionReciente || meta.hidratacion || ["-", "-"]).forEach(hid => { %>
            <tr><td><%= hid %></td></tr>
        <% }); %>
    </table>

    <div class="section-title">Lista de alimentos personales:</div>
    <table style="width: 450px;">
        <% (plan.alimentosPersonales || meta.alimentosPersonales || ["-"]).forEach(ali => { %>
            <tr><td><%= ali %></td></tr>
        <% }); %>
    </table>

    <% if (meta.estrategiaMaraton && meta.estrategiaMaraton.mostrar !== false) { %>
        <div class="section-title"><span class="highlight-yellow"><%= meta.estrategiaMaraton.titulo || 'Estrategia para 1/2 maraton' %></span></div>
        <table>
            <% (meta.estrategiaMaraton.filas || [["35 min", "1er gel"], ["1:10 hr", "2do gel"], ["1:45 hr hr", "3er gel + cafeina"]]).forEach(fila => { %>
                <tr>
                    <td style="width: 120px;"><%= fila[0] %></td>
                    <td><%= fila[1] %></td>
                </tr>
            <% }); %>
        </table>
    <% } %>
</div>
<% } %>

</body>
</html>
