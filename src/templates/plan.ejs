                            if (eqsM1.length > 0) {
                                allEqs.push(eqsM1.map(e => `${e.cantidad} eq ${e.grupo}`).join(' + '));
                            }
                            // Si el ingrediente fue marcado como libre o no generó ninguna equivalencia real
