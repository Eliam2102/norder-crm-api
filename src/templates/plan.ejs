                        if(!grouped1[plat]) grouped1[plat] = [];
                        grouped1[plat].push(ing);
                    });
                    
                    if (meta.soloEquivalencias) {
                        const allEqs = [];
                        const allLibres = [];
                        Object.values(grouped1).flat().forEach(ing => {
                            const eqsM1Raw = Array.isArray(ing.equivalencias) && ing.equivalencias.filter(e => e.grupo && String(e.grupo).trim() !== '' && e.cantidad !== '' && e.cantidad != null).length > 0
                                ? ing.equivalencias.filter(e => e.grupo && String(e.grupo).trim() !== '' && e.cantidad !== '' && e.cantidad != null)
                                : (ing.eqCantidad && ing.eqGrupo ? [{ cantidad: ing.eqCantidad, grupo: ing.eqGrupo }] : []);
                            
                            // Filtramos las que son "libre" para no mostrarlas como equivalencia numérica
                            const eqsM1 = eqsM1Raw.filter(e => parseFloat(e.cantidad) > 0 && !String(e.grupo).toLowerCase().includes('libre'));
