                                <% } else if (ing.descripcion) { %>
                                    <%= ing.descripcion %><% if(eqStrM1) { %> (<%= eqStrM1 %>)<% } %>
                                <% } %>
                            </div>
                        <%  });
                        });
                    } %>
                <% } %>
                
                <% if(tMenu1 && tMenu1.notaPie) { %>
                    <div class="menu-water"><%= tMenu1.notaPie %></div>
                <% } %>
                <% if(tMenu1 && tMenu1.bebida) { %>
